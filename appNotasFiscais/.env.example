# Copie para .env (uso local) ou cadastre na aba "Environment" do Easypanel

# ─── Banco de dados ──────────────────────────────────
# Pode ser o banco que você já usa para outros sistemas. O app cria sozinho, na
# primeira vez, um schema próprio (DB_SCHEMA) com as tabelas dele; nada fora desse
# schema é alterado. Se o banco indicado não existir, ele também é criado.
#
# Opção A: URL completa (Easypanel → serviço Postgres → "Internal Connection URL")
DATABASE_URL=postgres://usuario:senha@nome-do-servico-postgres:5432/nome_do_banco
#
# Opção B: variáveis separadas (apague a DATABASE_URL acima para usar estas)
# DB_HOST=nome-do-servico-postgres
# DB_PORT=5432
# DB_NAME=nome_do_banco
# DB_USER=postgres
# DB_PASSWORD=senha
#
# Schema onde ficam as tabelas do app (padrão: notas_fiscais)
DB_SCHEMA=notas_fiscais
# DB_SSL=true   # só se o banco exigir SSL (normalmente não, dentro do Easypanel)

# Endereço público usado no QR Code e nos links impressos. Nunca troque depois de imprimir etiquetas.
PUBLIC_BASE_URL=https://seu-nome.duckdns.org

# Segredo das sessões (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Consulta DANFE (consultadanfe.com, gratuita): busca a nota completa (XML + DANFE em PDF) pela chave
# quando a pessoa não envia o XML. Só funciona para NF-e de mês corrente (ou do anterior até o dia 15).
CONSULTA_DANFE=true
# CONSULTA_DANFE_URL=https://consultadanfe.com
# CONSULTA_DANFE_TIMEOUT=30
# Por padrão as consultas saem por IPv4 (em IPv6 o limite da API conta a faixa inteira do VPS).
# CONSULTA_DANFE_IPV4=false

# Impressão de etiquetas (/imprimir): por padrão quem se cadastrou pode imprimir.
# true = só o administrador imprime.
IMPRESSAO_SO_ADMIN=false

# Acesso ao painel /admin
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Pasta dos arquivos (no Easypanel, monte um Volume em /data)
DATA_DIR=/data
MAX_FILE_MB=10
PORT=3000
TZ=America/Sao_Paulo
